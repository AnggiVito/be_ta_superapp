# Application
NODE_ENV=development
# Port aplikasi (di dalam container Docker selalu 3000; override via docker-compose)
PORT=3000
# Port host untuk expose backend production (mis. 3002); opsional, fallback ke PORT
BACKEND_HOST_PORT=3002

# CORS Configuration
# Comma-separated list of allowed origins (e.g., "https://app.example.com,https://admin.example.com")
# In production, this MUST be set to specific domains. Do NOT use '*' in production.
# Leave empty in development to allow all browser origins (for testing).
# Requests without Origin (Postman, native apps) are always allowed; CORS only validates browser cross-origin calls.
CORS_ORIGIN=

# Rate limiting: skip tiered limits when browser sends Origin/Referer from official FE
# Default origins (if RATE_LIMIT_SKIP_ORIGINS empty): dev-praktikum + praktikum virtualfri
RATE_LIMIT_SKIP_OFFICIAL_FE=true
# RATE_LIMIT_SKIP_ORIGINS=https://dev-praktikum.virtualfri.id,https://praktikum.virtualfri.id

# AUTH GATEWAY
AUTH_GATEWAY_URL=https://dev-fri-gateway.virtualfri.id

# TTLOCK API
TTLOCK_API_URL=https://api.ttlock.com
TTLOCK_CLIENT_ID=your_ttlock_client_id
TTLOCK_CLIENT_SECRET=your_ttlock_client_secret

# Telegram Notifications
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_WEBHOOK_SECRET_TOKEN=your_webhook_secret_token
TELEGRAM_WEBHOOK_URL=https://your-backend.example.com/api/room-management/telegram/webhook
TELEGRAM_ROOM_BOOKING_CHAT_ID=your_telegram_group_chat_id
FRONTEND_BASE_URL=http://localhost:8080

# Registration Database
REGISTRATION_DB_HOST=registration_db
REGISTRATION_DB_PORT=5432
REGISTRATION_DB_USER=postgres
REGISTRATION_DB_PASSWORD=postgres
REGISTRATION_DB_NAME=registration_db

# Conduct Database
CONDUCT_DB_HOST=conduct_db
CONDUCT_DB_PORT=5432
CONDUCT_DB_USER=postgres
CONDUCT_DB_PASSWORD=postgres
CONDUCT_DB_NAME=conduct_db

# User Management Database
USER_MANAGEMENT_DB_HOST=user_management_db
USER_MANAGEMENT_DB_PORT=5432
USER_MANAGEMENT_DB_USER=postgres
USER_MANAGEMENT_DB_PASSWORD=postgres
USER_MANAGEMENT_DB_NAME=user_management_db

# Reporting Database
REPORTING_DB_HOST=reporting_db
REPORTING_DB_PORT=5432
REPORTING_DB_USER=postgres
REPORTING_DB_PASSWORD=postgres
REPORTING_DB_NAME=reporting_db

# User Management service URL (used for inter-service calls)
USER_MGMT_URL=http://user-management:3000

#Procurement Database
PROCUREMENT_DB_HOST=procurement_db
PROCUREMENT_DB_PORT=5432
PROCUREMENT_DB_USER=postgres
PROCUREMENT_DB_PASSWORD=postgres
PROCUREMENT_DB_NAME=procurement_db

# Room Management Database 
ROOM_MANAGEMENT_DB_HOST=room_management_db
ROOM_MANAGEMENT_DB_PORT=5432
ROOM_MANAGEMENT_DB_USER=postgres
ROOM_MANAGEMENT_DB_PASSWORD=postgres
ROOM_MANAGEMENT_DB_NAME=room_management_db

# Procurement blockchain handover
CONTRACT_ADDRESS=0x7fb84aFf1311A8bc93751d1AA805e7904903ACFa
CHAIN_ID=11155111
NETWORK=Ethereum Sepolia Testnet
RPC_URL=https://rpc.sepolia.org
RELAYER_PRIVATE_KEY=
DEFAULT_LABORAN_WALLET=0x24dd09681D0545C84AEc89D42CF645f6c1694939


# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET=your_jwt_secret_key

# Migration
# Set to 'false' to disable automatic migrations on startup (default: true)
RUN_MIGRATIONS=true

# File Upload
# Directory untuk menyimpan uploaded files (default: ./uploads)
UPLOAD_DIR=./uploads

# Bootstrap
# User ID untuk assign role kaur_lab pertama kali (dari AUTH GATEWAY)
# Set user_id dari Kepala Urusan Laboratorium yang akan menjadi Kaur Lab pertama
FIRST_KAUR_LAB_USER_ID=
# Set to 'true' to enable automatic bootstrap on startup (default: true)
RUN_BOOTSTRAP=true

# Periode aktif default saat development (jika gateway GET /periodes tidak tersedia)
DEV_ACTIVE_PERIODE=2526-2

