{
  "name": "fri-super-app-backend",
  "version": "0.1.0-beta.1",
  "description": "Backend untuk FRI Super App - Modular Monolith dengan Multiple Databases",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "migrate": "node scripts/run-migrations.js",
    "migrate:module": "node scripts/run-module-migration.js",
    "migrate:conduct": "node scripts/run-conduct-migration.js",
    "migrate:registration": "node scripts/run-module-migration.js registration",
    "migrate:user-management": "node scripts/run-module-migration.js user-management",
    "migrate:reporting": "node scripts/run-module-migration.js reporting",
    "migrate:procurement": "node scripts/run-module-migration.js procurement",
    "migrate:room-management": "node scripts/run-module-migration.js room-management",
    "migrate:pg": "node scripts/run-pg-migration.js",
    "migrate:pg:registration": "node scripts/run-pg-migration.js registration",
    "migrate:pg:conduct": "node scripts/run-pg-migration.js conduct",
    "migrate:pg:user-management": "node scripts/run-pg-migration.js user-management",
    "migrate:pg:reporting": "node scripts/run-pg-migration.js reporting",
    "migrate:pg:procurement": "node scripts/run-pg-migration.js procurement",
    "migrate:pg:room-management": "node scripts/run-pg-migration.js room-management",
    "migrate:pg:activity-log": "node scripts/run-pg-migration.js activity-log",
    "migrate:bootstrap": "node scripts/bootstrap-migration-tracking.js",
    "migrate:create": "node scripts/create-migration.js",
    "migrate:setup": "node scripts/migrate-setup.js",
    "migrate:check": "node scripts/migrate-setup.js",
    "migrate:unified": "node scripts/run-unified-migration.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs --coverage",
    "test:reporting": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs modules/reporting/tests",
    "test:qr": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs modules/conduct/__tests__/qrAttendance"
  },
  "keywords": [
    "backend",
    "express",
    "modular-monolith",
    "microservices"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "ethers": "^6.13.4",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0-rc.4",
    "node-pg-migrate": "^6.2.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.11.3",
    "pg-format": "^1.0.4",
    "puppeteer-core": "^21.11.0",
    "qrcode": "^1.5.4",
    "redis": "^4.6.12",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^11.0.3",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "jest": "^30.2.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.1.4"
  }
}
